{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Yarp": "Information"
    }
  },
  "AllowedHosts": "*",
  "ReverseProxy": {
    "Routes": {
      "identity-route": {
        "ClusterId": "identity-cluster",
        "Match": {
          "Path": "/api/auth/{**catch-all}"
        }
      },
      "users-route": {
        "ClusterId": "identity-cluster",
        "Match": {
          "Path": "/api/users/{**catch-all}"
        }
      },
      "candidate-route": {
        "ClusterId": "candidate-cluster",
        "Match": {
          "Path": "/api/candidate-profile/{**catch-all}"
        }
      },
      "company-profile-route": {
        "ClusterId": "company-cluster",
        "Match": {
          "Path": "/api/company-profile/{**catch-all}"
        }
      },
      "jobs-route": {
        "ClusterId": "company-cluster",
        "Match": {
          "Path": "/api/jobs/{**catch-all}"
        }
      },
      "application-route": {
        "ClusterId": "application-cluster",
        "Match": {
          "Path": "/api/job-applications/{**catch-all}"
        }
      },
      "quiz-route": {
        "ClusterId": "quiz-cluster",
        "Match": {
          "Path": "/api/quiz/{**catch-all}"
        }
      },
      "matching-route": {
        "ClusterId": "matching-cluster",
        "Match": {
          "Path": "/api/matching/{**catch-all}"
        }
      },
      "notification-route": {
        "ClusterId": "notification-cluster",
        "Match": {
          "Path": "/api/notifications/{**catch-all}"
        }
      },
      "realtime-route": {
        "ClusterId": "notification-cluster",
        "Match": {
          "Path": "/hubs/realtime/{**catch-all}"
        }
      }
    },
    "Clusters": {
      "identity-cluster": {
        "Destinations": {
          "identity-api": {
            "Address": "http://localhost:5018/"
          }
        }
      },
      "candidate-cluster": {
        "Destinations": {
          "candidate-api": {
            "Address": "http://localhost:5193/"
          }
        }
      },
      "company-cluster": {
        "Destinations": {
          "company-api": {
            "Address": "http://localhost:5063/"
          }
        }
      },
      "application-cluster": {
        "Destinations": {
          "application-api": {
            "Address": "http://localhost:5158/"
          }
        }
      },
      "quiz-cluster": {
        "Destinations": {
          "quiz-api": {
            "Address": "http://localhost:5015/"
          }
        }
      },
      "matching-cluster": {
        "Destinations": {
          "matching-one": {
            "Address": "http://localhost:5286/"
          }
        }
      },
      "notification-cluster": {
        "Destinations": {
          "notification-api": {
            "Address": "http://localhost:5270/"
          }
        }
      }
    }
  }
}
